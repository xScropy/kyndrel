# Kyndrel's resource budget (PLAN.md Phase 8). scripts/measure_perf.sh fails
# when a measurement goes over its budget, or more than TOLERANCE_PCT over
# the recorded baseline (perf/baseline-*.env, written with --record).

TOLERANCE_PCT=10

# Desktop (Linux, measured under Xvfb with software rendering).
LINUX_IDLE_RSS_MB=150
LINUX_IDLE_CPU_PCT=2

# Android (dumpsys meminfo TOTAL PSS; gfxinfo janky frames).
ANDROID_IDLE_PSS_MB=110
ANDROID_PLAY_PSS_MB=220
ANDROID_JANKY_PCT=5
